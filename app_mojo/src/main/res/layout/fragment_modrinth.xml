<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181818"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JAR MOD CENTER"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover and install Minecraft content"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:padding="8dp" />

        <EditText
            android:id="@+id/mod_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search mods, shaders, packs..."
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:singleLine="true"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/tab_mods"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mods" />

            <Button
                android:id="@+id/tab_shaders"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Shaders" />

            <Button
                android:id="@+id/tab_packs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Packs" />
        </LinearLayout>

    <LinearLayout
    android:id="@+id/mod_results"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp" />

    </LinearLayout>
</ScrollView>
